<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>A Fábula da Ostra - Ilustrativo</title>
    <style>
        :root {
            --fundo-mar: radial-gradient(circle at center, #1e293b 0%, #03081e 100%);
            --cor-ostra: #e2e8f0;
            --cor-borda: #94a3b8;
            --brilho-perola: rgba(140, 115, 51, 0.5);
        }

        body {
            margin: 0;
            height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            background: var(--fundo-mar);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: white;
            overflow: hidden;
        }

        /* Contentor da Ostra com Perspetiva 3D */
        .cenario {
            perspective: 1000px;
            cursor: pointer;
        }

        .ostra {
            position: relative;
            width: 240px;
            height: 180px;
            transform-style: preserve-3d;
            transition: transform 1s ease;
        }

        /* Concha Superior (A tampa que abre) */
        .concha-superior {
            position: absolute;
            top: 0;
            width: 100%;
            height: 50%;
            background: var(--cor-ostra);
            border: 4px solid var(--cor-borda);
            border-radius: 120px 120px 20px 20px;
            z-index: 3;
            transform-origin: bottom center;
            transition: transform 2s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: inset 0 8px 15px #fff, 0 -2px 10px rgba(0,0,0,0.3);
        }

        /* Interior da Concha Superior (Nácar) */
        .concha-superior::after {
            content: '';
            position: absolute;
            bottom: 5px; left: 10%; width: 80%; height: 80%;
            background: linear-gradient(to top, #f1f5f9, #cbd5e1);
            border-radius: 100px 100px 10px 10px;
            opacity: 0.5;
        }

        /* Concha Inferior (Base fixa) */
        .concha-inferior {
            position: absolute;
            bottom: 0;
            width: 100%;
            height: 50%;
            background: #cbd5e1;
            border: 4px solid var(--cor-borda);
            border-radius: 20px 20px 120px 120px;
            z-index: 1;
            box-shadow: inset 0 -10px 20px rgba(0,0,0,0.2);
        }

        /* A PÉROLA NEGRA */
        .perola-negra {
            position: absolute;
            bottom: 25%;
            left: 50%;
            width: 35px;
            height: 35px;
            /* Gradiente para efeito de esfera metálica/negra */
            background: radial-gradient(circle at 35% 35%, #475569 0%, #1e293b 40%, #020617 80%);
            border-radius: 50%;
            z-index: 2;
            transform: translateX(-50%) scale(0);
            transition: transform 1.5s ease 0.5s, box-shadow 1.5s ease 0.5s;
            box-shadow: 0 0 5px rgba(0,0,0,0.5);
        }

        /* Efeito de Reflexo de Luz na Pérola */
        .perola-negra::before {
            content: '';
            position: absolute;
            top: 20%; left: 25%; width: 6px; height: 6px;
            background: white;
            border-radius: 50%;
            filter: blur(1px);
            opacity: 0.8;
        }

        /* ANIMAÇÃO AO CLICAR OU PASSAR O RATO */
        .cenario.aberto .concha-superior {
            transform: rotateX(-115deg) translateY(-15px);
        }

        .cenario.aberto .perola-negra {
            transform: translateX(-50%) scale(1);
            box-shadow: 0 0 30px var(--brilho-perola), 0 0 60px rgba(255,255,255,0.1);
            animation: flutuar 3s infinite ease-in-out 2s;
        }

        @keyframes flutuar {
            0%, 100% { transform: translateX(-50%) translateY(0); }
            50% { transform: translateX(-50%) translateY(-10px); }
        }

        .legenda {
            margin-top: 50px;
            text-align: center;
            max-width: 400px;
            line-height: 1.6;
            opacity: 0.8;
        }

        .botao-abrir {
            margin-top: 20px;
            padding: 10px 25px;
            background: transparent;
            border: 1px solid white;
            color: white;
            border-radius: 20px;
            cursor: pointer;
            transition: 0.3s;
        }

        .botao-abrir:hover {
            background: white;
            color: #03081e;
        }
    </style>
</head>
<body>

    <div class="cenario" id="boxOstra" onclick="toggleOstra()">
        <div class="ostra">
            <div class="concha-superior"></div>
            <div class="perola-negra"></div>
            <div class="concha-inferior"></div>
        </div>
    </div>

    <div class="legenda">
        <p><i>"A pérola é a prova de que uma ferida pode ser transformada em algo precioso."</i></p>
        <button class="botao-abrir" onclick="toggleOstra()">ABRIR OSTRA</button>
    </div>

    <script>
        function toggleOstra() {
            const box = document.getElementById('boxOstra');
            box.classList.toggle('aberta');
            
            const btn = document.querySelector('.botao-abrir');
            if(box.classList.contains('aberta')) {
                btn.innerText = "FECHAR OSTRA";
            } else {
                btn.innerText = "ABRIR OSTRA";
            }
        }

        // Abre automaticamente após 1 segundo para mostrar o efeito
        setTimeout(() => {
            document.getElementById('boxOstra').classList.add('aberta');
            document.querySelector('.botao-abrir').innerText = "FECHAR OSTRA";
        }, 1000);
    </script>
</body>
</html>
