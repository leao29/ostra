<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>A Ostra e a Pérola Negra</title>
    <style>
        /* Fundo do Mar Profundo */
        body {
            margin: 0;
            padding: 0;
            height: 100vh;
            background: radial-gradient(circle at center, #101f42 0%, #03081e 100%);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            font-family: Arial, sans-serif;
            color: white;
            overflow: hidden;
        }

        h1 {
            font-size: 24px;
            margin-bottom: 40px;
            letter-spacing: 2px;
            text-shadow: 0 0 10px rgba(255,255,255,0.3);
        }

        /* Cenário 3D da Ostra */
        .cenario {
            perspective: 1000px;
            cursor: pointer;
        }

        .ostra {
            position: relative;
            width: 200px;
            height: 150px;
            transform-style: preserve-3d;
        }

        /* Tampa da Ostra (Concha Superior) */
        .concha-superior {
            position: absolute;
            top: 0;
            width: 100%;
            height: 52%;
            background: #e2e8f0;
            border: 3px solid #94a3b8;
            border-radius: 100px 100px 15px 15px;
            z-index: 3;
            transform-origin: bottom center;
            transition: transform 2s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: inset 0 8px 15px #fff;
        }

        /* Base da Ostra (Concha Inferior) */
        .concha-inferior {
            position: absolute;
            bottom: 0;
            width: 100%;
            height: 52%;
            background: #cbd5e1;
            border: 3px solid #94a3b8;
            border-radius: 15px 15px 100px 100px;
            z-index: 1;
            box-shadow: inset 0 -8px 15px rgba(0,0,0,0.2);
        }

        /* A PÉROLA NEGRA BRILHANTE */
        .perola-negra {
            position: absolute;
            bottom: 25%;
            left: 50%;
            width: 32px;
            height: 32px;
            /* Gradiente realista de pérola negra */
            background: radial-gradient(circle at 35% 35%, #5a697e 0%, #1e293b 45%, #020617 95%);
            border-radius: 50%;
            z-index: 2;
            transform: translateX(-50%) scale(0);
            transition: transform 1.5s ease 0.5s, box-shadow 1.5s ease 0.5s;
        }

        /* Ponto de luz na pérola */
        .perola-negra::before {
            content: '';
            position: absolute;
            top: 20%; left: 25%;
            width: 5px; height: 5px;
            background: white;
            border-radius: 50%;
            opacity: 0.8;
        }

        /* EFEITO DE ABRIR (Ativado automaticamente ou pelo clique) */
        .cenario.aberta .concha-superior {
            transform: rotateX(-110deg) translateY(-10px);
        }

        .cenario.aberta .perola-negra {
            transform: translateX(-50%) scale(1);
            box-shadow: 0 0 25px rgba(140, 115, 51, 0.7), 0 0 50px rgba(255,255,255,0.2);
            animation: flutuar 3s infinite ease-in-out 2s;
        }

        @keyframes flutuar {
            0%, 100% { transform: translateX(-50%) translateY(0); }
            50% { transform: translateX(-50%) translateY(-8px); }
        }

        .instrucao {
            margin-top: 30px;
            font-size: 14px;
            color: #94a3b8;
        }
    </style>
</head>
<body>

    <h1>A transformação da dor em joia rara...</h1>

    <!-- Clique na ostra para testar o efeito manual também -->
    <div class="cenario" id="minhaOstra" onclick="interagirOstra()">
        <div class="ostra">
            <div class="concha-superior"></div>
            <div class="perola-negra"></div>
            <div class="concha-inferior"></div>
        </div>
    </div>

    <p class="instrucao">A ostra se abre revelando o seu tesouro.</p>

    <script>
        const ostraContainer = document.getElementById('minhaOstra');

        // Abre automaticamente 1 segundo após a página carregar
        setTimeout(() => {
            ostraContainer.classList.add('aberta');
        }, 1000);

        // Se a pessoa clicar, ela fecha ou abre novamente
        function interagirOstra() {
            ostraContainer.classList.toggle('aberta');
        }
    </script>
</body>
</html>
